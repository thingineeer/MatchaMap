    "att.prompt.title" : {
      "extractionState" : "manual",
      "comment" : "ATT prompt secondary explainer (system shows after Info.plist key).",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "맞춤 광고를 위해 추적을 허용해주세요" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow tracking for personalised ads" } },
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Allow tracking for personalised ads" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tracking für personalisierte Anzeigen erlauben" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "パーソナライズ広告のためトラッキングを許可" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser le suivi pour des annonces personnalisées" } }
