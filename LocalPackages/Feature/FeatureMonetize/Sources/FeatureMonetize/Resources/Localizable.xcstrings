    },
    "att.prompt.body" : {
      "extractionState" : "manual",
      "comment" : "ATT explainer body. Maps to NSUserTrackingUsageDescription. ASCII-safe length.",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "허용하면 더 관련성 높은 광고를 보여드릴 수 있어요. 거부해도 앱은 정상 동작합니다." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We use this to show more relevant ads. The app works either way." } },
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "We use this to show more relevant ads. The app works either way." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Damit zeigen wir relevantere Anzeigen. Die App funktioniert auch ohne." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "より関連性の高い広告のために使用します。許可しなくてもアプリは動作します。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour des annonces plus pertinentes. L'application fonctionne dans tous les cas." } }
      }
    }
  }
