    "말차맵에\n오신 걸 환영해요" : {
      "extractionState" : "manual",
      "comment" : "Login welcome headline. 2 lines.",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "말차맵에\n오신 걸 환영해요" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome\nto MatchaMap" } },
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Welcome\nto MatchaMap" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Willkommen\nbei MatchaMap" } },
