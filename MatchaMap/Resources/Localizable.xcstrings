      }
    },
    "로그인하면 마신 말차와 위시리스트를\n모든 기기에서 동기화할 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로그인하면 마신 말차와 위시리스트를\n모든 기기에서 동기화할 수 있어요." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to sync your matcha log\nand wishlist across every device." } },
