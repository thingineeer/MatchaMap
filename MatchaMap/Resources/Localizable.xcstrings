    "세상의 말차를\n한 잔씩 모아두는 곳" : {
      "extractionState" : "manual",
      "comment" : "Splash tagline. Preserve newline; keep both lines balanced.",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "세상의 말차를\n한 잔씩 모아두는 곳" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Collecting the world's matcha,\none cup at a time" } },
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Collecting the world's matcha,\none cup at a time" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Matcha-Welt,\nTasse für Tasse gesammelt" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "世界の抹茶を\n一杯ずつ集める場所" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le matcha du monde,\nune tasse à la fois" } }
      }
    },
