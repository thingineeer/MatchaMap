# Fastfile — 말차맵(MatchaMap) iOS CI/CD
# 레퍼런스: ~/Desktop/FearIndex-iOS/fastlane/Fastfile (성공 출시 검증된 패턴)
# 빌드 번호 규칙: YYMMDD_HHMM (KST) — CLAUDE.md § 7

default_platform(:ios)

# ─── 상수 ───────────────────────────────────────────────
APP_IDENTIFIER = ENV["APP_IDENTIFIER"] || "th1ngjin.MatchaMap"
SCHEME         = "MatchaMap"
PROJECT        = "MatchaMap.xcodeproj"
INFO_PLIST     = "MatchaMap/Info.plist"

# ─── before_all ─────────────────────────────────────────
before_all do
  setup_ci if ENV["CI"]
  ENV["TZ"] ||= "Asia/Seoul"
end

platform :ios do

  # ============================================
  # 1) 빌드 번호 — YYMMDD_HHMM (KST)
  # ============================================
  desc "빌드 번호를 YYMMDD_HHMM(KST)로 갱신"
  lane :bump_build do
    bn = Time.now.strftime("%y%m%d_%H%M")
    set_info_plist_value(path: INFO_PLIST, key: "CFBundleVersion", value: bn)
    UI.success("Build number → #{bn}")
    bn
  end

  # ============================================
  # 2) 인증서 — match로 동기화 (vault git repo 사용)
  # ============================================
  desc "인증서·프로비저닝 프로파일 동기화 (match)"
  lane :sync_certificates do
    setup_api_key_lane
    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      readonly: is_ci
    )
  end

  desc "ASC API 키 로드 (~/.env-vault/projects/matchamap-ios/api_key.json)"
  private_lane :setup_api_key_lane do
    key_path = ENV["ASC_API_KEY_PATH"] || File.expand_path("~/.env-vault/projects/matchamap-ios/api_key.json")
    if File.exist?(key_path)
      app_store_connect_api_key(json_key_filepath: key_path, in_house: false)
    else
      UI.user_error!("ASC API key not found at #{key_path}. vault에 저장하세요.")
    end
  end

  # ============================================
  # 3) Beta — TestFlight 업로드
  # ============================================
  desc "TestFlight 업로드 (build → archive → upload)"
  lane :beta do |options|
    setup_api_key_lane
    sync_certificates
    bump_build

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: "fastlane/ExportOptions.plist",
      output_directory: "./build/ipa-out",
      output_name: "#{SCHEME}.ipa",
      clean: true
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: options[:changelog] || "내부 테스트 빌드"
    )

    refresh_dsyms
  end

  # ============================================
  # 4) Release — 심사 제출 (자동 출시)
  # ============================================
  desc "App Store 심사 제출 (이미 ASC에 올라간 빌드 사용, 자동 출시)"
  lane :submit_for_review do |options|
    setup_api_key_lane
    current_version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    target_version = options[:app_version] || current_version

    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      app_version: target_version,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: true,
        export_compliance_uses_encryption: false,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: true,
        add_id_info_limits_tracking: true
      }
    )

    UI.success("심사 제출 완료! 버전: #{target_version}")
  end

  # ============================================
  # 5) dSYM — Crashlytics 업로드
  # ============================================
  desc "최신 dSYM을 Crashlytics에 업로드"
  lane :refresh_dsyms do
    setup_api_key_lane
    download_dsyms(version: "latest", wait_for_dsym_processing: true) rescue UI.message("dSYM not yet available")
    if Dir.glob("*.dSYM.zip").any?
      upload_symbols_to_crashlytics(gsp_path: "MatchaMap/GoogleService-Info.plist")
      clean_build_artifacts
    end
  end

  # ============================================
  # 6) 메타데이터 업로드 (6개 언어)
  # ============================================
  desc "App Store 메타데이터/whatsnew 6개 언어 업로드"
  lane :upload_metadata do
    setup_api_key_lane
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      force: true
    )
  end

  # ============================================
  # 7) 스크린샷 (snapshot)
  # ============================================
  desc "시뮬레이터 스크린샷 6개 언어 일괄 생성"
  lane :screenshots do
    capture_screenshots(workspace: nil, project: PROJECT, scheme: "#{SCHEME}UITests")
  end

  # ============================================
  # 8) 헬스체크
  # ============================================
  desc "프로젝트 빌드 헬스체크 (Debug, 시뮬레이터)"
  lane :doctor do
    xcodebuild(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      build: true,
      clean: true
    )
    UI.success("Build OK")
  end
end
