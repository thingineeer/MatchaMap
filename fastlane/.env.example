# fastlane 환경변수 템플릿. 실값은 ~/.env-vault/projects/matchamap-ios/.env 에 두고 symlink로 .env 연결.

APP_IDENTIFIER=th1ngjin.MatchaMap
APPLE_ID=
TEAM_ID=
ITC_TEAM_ID=

# match
MATCH_GIT_URL=https://github.com/thingineeer/thingineeer-env
MATCH_PASSWORD=

# ASC API
ASC_API_KEY_PATH=~/.env-vault/projects/matchamap-ios/api_key.json

# Firebase / AdMob
GOOGLE_APP_ID_IOS=
ADMOB_APP_ID_IOS=
ADMOB_BANNER_MAP_UNIT_ID=
ADMOB_INTERSTITIAL_STORE_UNIT_ID=
ADMOB_REWARDED_COLLECTION_UNIT_ID=
