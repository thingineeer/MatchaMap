# 말차맵(MatchaMap) 로컬 개발 환경변수 템플릿
# 실값은 ~/.env-vault/projects/matchamap-ios/.env 에 작성하고 symlink:
#   ln -s ~/.env-vault/projects/matchamap-ios/.env .env

# Apple Developer
APP_IDENTIFIER=th1ngjin.MatchaMap
APPLE_ID=
TEAM_ID=
ITC_TEAM_ID=

# Firebase
GOOGLE_APP_ID_IOS=
FIREBASE_PROJECT_ID=MatchaMapAPP

# Google Maps SDK
GMS_API_KEY_IOS=
GMS_PLACES_API_KEY=

# AdMob
ADMOB_APP_ID_IOS=
ADMOB_BANNER_MAP_UNIT_ID=
ADMOB_INTERSTITIAL_STORE_UNIT_ID=
ADMOB_REWARDED_COLLECTION_UNIT_ID=

# match
MATCH_GIT_URL=https://github.com/thingineeer/thingineeer-env
MATCH_PASSWORD=

# Build (auto by fastlane bump_build)
TZ=Asia/Seoul
