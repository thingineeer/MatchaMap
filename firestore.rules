// MatchaMap — Firestore Security Rules
// ============================================================================
// 작성: server-auth (ADR-303)
// SSOT: docs/server/schema.md (server-data, ADR-302)
// 정책 출처:
//   - docs/architecture/ADR-303-app-check-security-rules.md §2
//   - docs/server/security-rules.md (패턴 P1~P6 + 신규 P7/P8)
//   - docs/architecture/ADR-302-firestore-schema.md § 보안 규칙 영향
//
// 절대 원칙:
//   1. Default Deny — 모든 컬렉션은 if false. 명시 허용 패턴만 통과.
//   2. App Check 강제 — 모든 요청은 isAppCheckOk().
//   3. 사용자 격리 — 사용자 데이터는 request.auth.uid == doc owner 또는 path uid.
//   4. 신뢰 경계 — 집계/모더레이션 필드(stats.*, likeCount, flagged, verified, ratingAvg, reviewCount,
//      ratingHistogram, tagsTop, flagCount) 클라 변경 차단. Functions Admin SDK only.
//   5. 검증 — 타입/길이/enum은 rules에서 1차. 비즈니스 검증은 Functions에서.
//   6. read도 권한 검사 — 사용자 개인 데이터(wishlists/collections/friendships)는 read도 본인만.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 헬퍼 (ADR-303 §2.4)
    // ========================================================================
    function isAuthed() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }
    function isAppCheckOk() {
      return request.app != null;
    }
    function strLen(s, minLen, maxLen) {
      return s is string && s.size() >= minLen && s.size() <= maxLen;
    }
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }
    function isCountryCode(s) {
      return s is string && s.size() == 2;
    }

    // ========================================================================
    // [P1] users/{uid} — 사용자 프로필 (schema.md §1)
    //   read: self · App Check
    //   create: self · displayName/locale/homeCountry/authMethod/uid 필수, stats=0 검증
    //   update: self · uid/createdAt/cohortD0/authMethod/stats 불변
    //          (homeCountry는 첫 30일 보정 후 동결 — 클라 정책으로 강제, 규칙은 변경 허용)
    //   delete: false (탈퇴는 Functions onUserDelete)
    // ========================================================================
    match /users/{uid} {
      allow read: if isSelf(uid) && isAppCheckOk();

      allow create: if isSelf(uid)
                    && isAppCheckOk()
                    && request.resource.data.uid == uid
                    && strLen(request.resource.data.displayName, 1, 32)
                    && request.resource.data.locale is string
                    && isCountryCode(request.resource.data.homeCountry)
                    && request.resource.data.authMethod in ['apple', 'passkey']
                    && request.resource.data.cohortD0 == request.time
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.stats.collectionCount == 0
                    && request.resource.data.stats.reviewCount == 0
                    && request.resource.data.stats.wishlistCount == 0
                    && request.resource.data.stats.friendCount == 0;

      allow update: if isSelf(uid)
                    && isAppCheckOk()
                    && isUnchanged('uid')
                    && isUnchanged('createdAt')
                    && isUnchanged('cohortD0')
                    && isUnchanged('authMethod')
                    && isUnchanged('stats')
                    && (request.resource.data.displayName == resource.data.displayName
                        || strLen(request.resource.data.displayName, 1, 32))
                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      // ----------------------------------------------------------------------
      // private 서브컬렉션 (계정 삭제 진행 추적 등 Functions 전용)
      // ----------------------------------------------------------------------
      match /private/{docId} {
        allow read, write: if false;
      }

      // ----------------------------------------------------------------------
      // FCM 토큰 — 다중 디바이스 지원 (push-payload.md 정합)
      //   클라가 부팅 시 자기 디바이스 토큰 등록/갱신/삭제.
      //   토큰 자체에 PII 없음. 만료 토큰 정리는 scheduler/cleanupStaleFcmTokens.
      // ----------------------------------------------------------------------
      match /fcmTokens/{tokenId} {
        allow read:   if isSelf(uid) && isAppCheckOk();
        allow create: if isSelf(uid)
                      && isAppCheckOk()
                      && request.resource.data.uid == uid
                      && request.resource.data.token is string
                      && request.resource.data.platform == 'ios'
                      && request.resource.data.createdAt == request.time;
        allow update: if isSelf(uid)
                      && isAppCheckOk()
                      && isUnchanged('uid')
                      && isUnchanged('createdAt')
                      && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(uid) && isAppCheckOk();
      }
    }

    // ========================================================================
    // [P2] stores/{placeId} — 매장 마스터 (schema.md §2)
    //   read: any authenticated · App Check
    //   write: false (큐레이터 시드 + Functions seedStores/recomputeStoreAggregates only)
    //   v1.0.0은 사용자 매장 등록 비범위. origin 필드는 Functions only write.
    // ========================================================================
    match /stores/{placeId} {
      allow read:  if isAuthed() && isAppCheckOk();
      allow write: if false;
    }

    // ========================================================================
    // [P3] reviews/{reviewId} — 매장 리뷰 (schema.md §3)
    //   read: any authenticated
    //   create: author + AppCheck + 디노멀 일관성(author.uid == auth.uid, store.placeId == storeId,
    //           country == store.country)
    //           likeCount/flagged/flagCount는 0/false로만 생성
    //   update: author만 + 집계/모더레이션/디노멀 필드 불변 (body/rating만 변경)
    //   delete: author (또는 onUserDelete가 Admin SDK로 삭제)
    //
    //   주의: client-side 디노멀 일관성 검증과 별도로, server-functions의 onCreate 트리거
    //   onReviewCreate가 author/store 디노멀 필드를 Admin SDK로 덮어쓰기 (single source of truth).
    //   본 규칙은 클라가 명백히 잘못된 디노멀을 보내는 경우 1차 거부.
    // ========================================================================
    match /reviews/{reviewId} {
      allow read: if isAuthed() && isAppCheckOk();

      allow create: if isAuthed()
                    && isAppCheckOk()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.author.uid == request.auth.uid
                    && strLen(request.resource.data.storeId, 1, 200)
                    && request.resource.data.store.placeId == request.resource.data.storeId
                    && request.resource.data.country == request.resource.data.store.country
                    && isCountryCode(request.resource.data.country)
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && strLen(request.resource.data.body, 1, 2000)
                    && request.resource.data.likeCount == 0
                    && request.resource.data.flagged == false
                    && request.resource.data.flagCount == 0
                    && request.resource.data.createdAt == request.time;

      allow update: if isAuthed()
                    && isAppCheckOk()
                    && resource.data.uid == request.auth.uid
                    && isUnchanged('uid')
                    && isUnchanged('storeId')
                    && isUnchanged('createdAt')
                    && isUnchanged('country')
                    && isUnchanged('store')
                    && isUnchanged('author')
                    && isUnchanged('likeCount')
                    && isUnchanged('flagged')
                    && isUnchanged('flagCount')
                    && (request.resource.data.body == resource.data.body
                        || strLen(request.resource.data.body, 1, 2000))
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isAuthed()
                    && isAppCheckOk()
                    && resource.data.uid == request.auth.uid;
    }

    // ========================================================================
    // [P4] wishlists/{uid}/items/{storeId} — 위시리스트 (schema.md §4)
    //   doc.id == storeId == data.storeId == data.store.placeId 4중 일치 검증.
    //   read/write: self · App Check
    // ========================================================================
    match /wishlists/{uid}/items/{storeId} {
      allow read: if isSelf(uid) && isAppCheckOk();

      allow create: if isSelf(uid)
                    && isAppCheckOk()
                    && request.resource.data.uid == uid
                    && request.resource.data.storeId == storeId
                    && request.resource.data.store.placeId == storeId
                    && isCountryCode(request.resource.data.country)
                    && request.resource.data.country == request.resource.data.store.country
                    && request.resource.data.addedAt == request.time;

      allow update: if isSelf(uid)
                    && isAppCheckOk()
                    && isUnchanged('uid')
                    && isUnchanged('storeId')
                    && isUnchanged('addedAt')
                    && isUnchanged('store')
                    && isUnchanged('country');

      allow delete: if isSelf(uid) && isAppCheckOk();
    }

    // ========================================================================
    // [P5] collections/{uid}/items/{itemId} — 도감 (schema.md §5)
    //   read: self만 (도감은 사적 자원, 친구 노출은 feed_events 경유)
    //   write: false → 콜러블 addCollectionItem/updateCollectionItem/deleteCollectionItem 경유
    //          fanout(users.stats.collectionCount ±1, feed_events create) 보장 위해 Functions only.
    // ========================================================================
    match /collections/{uid}/items/{itemId} {
      allow read:  if isSelf(uid) && isAppCheckOk();
      allow write: if false;
    }

    // ========================================================================
    // [P6] likes/{reviewId}/users/{uid} — 좋아요 마커 (schema.md §0.3 디노멀)
    //   read: any authenticated (좋아요 표시)
    //   create/delete: self only (좋아요 토글, idempotent)
    //   update: false
    //   reviews.likeCount 갱신은 Functions onLikeWrite (server-functions) 책임.
    // ========================================================================
    match /likes/{reviewId}/users/{uid} {
      allow read:   if isAuthed() && isAppCheckOk();
      allow create: if isSelf(uid)
                    && isAppCheckOk()
                    && request.resource.data.uid == uid
                    && request.resource.data.reviewId == reviewId;
      allow delete: if isSelf(uid) && isAppCheckOk();
      allow update: if false;
    }

    // ========================================================================
    // [P7] friendships/{uid}/edges/{friendUid} — 친구 관계 (schema.md §6, ADR-302 신규)
    //   read: self만 (자신의 친구 목록만)
    //   write: false → 콜러블 requestFriend/acceptFriend/removeFriend (양방향 doc 정합 보장)
    //   양방향 정합(A/edges/B + B/edges/A 동시 갱신)을 클라에 맡기지 않음.
    // ========================================================================
    match /friendships/{uid}/edges/{friendUid} {
      allow read:  if isSelf(uid) && isAppCheckOk();
      allow write: if false;
    }

    // ========================================================================
    // [P8] feed_events/{eventId} — 친구 피드 (schema.md §7, ADR-302 신규)
    //   read: 본인이 audience에 포함된 경우만 (request.auth.uid in resource.data.audienceUids)
    //   write: false → Functions가 fanout-on-write로 doc 생성
    //   visibility=public(v1.1.0+) 도입 시 본 규칙에 별도 분기 추가.
    //   90일 retention은 scheduler/cleanupFeedEvents가 처리.
    // ========================================================================
    match /feed_events/{eventId} {
      allow read:  if isAuthed()
                   && isAppCheckOk()
                   && request.auth.uid in resource.data.audienceUids;
      allow write: if false;
    }

    // ========================================================================
    // analytics/sessions/{sessionId} — 분석 세션 (schema.md §8, 선택 도입)
    //   read: self만 (자신의 세션 기록 조회)
    //   write: false → 콜러블 recordSession (Functions만)
    //   GA4 export가 분석 SSOT, 본 컬렉션은 Functions 내부 추적 + 디버깅용.
    // ========================================================================
    match /analytics/sessions/{sessionId} {
      allow read:  if isAuthed()
                   && isAppCheckOk()
                   && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ========================================================================
    // analytics/events/{eventId} — 분석 이벤트 미러 (schema.md §9, 선택 도입)
    //   read: false (분석은 BigQuery export SSOT, Firestore에서 직접 read 안 함)
    //   write: false (Functions only)
    //   30일 후 Cloud Scheduler가 자동 삭제.
    // ========================================================================
    match /analytics/events/{eventId} {
      allow read, write: if false;
    }

    // ========================================================================
    // Default Deny — 위에 정의되지 않은 모든 경로
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
